# Script generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Stock footage (https://www.pexels.com/api/) - free tier, videos are free to use
PEXELS_API_KEY=

# Text-to-speech voice (Microsoft Edge neural voices, free, no key needed)
TTS_VOICE=en-US-GuyNeural

# Caption transcription model size: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base

# Instagram Graph API (Business/Creator account linked to a Facebook Page)
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# S3 bucket used to host the rendered video at a public URL for Instagram to fetch
S3_BUCKET=
AWS_REGION=us-east-1

OUTPUT_DIR=output
