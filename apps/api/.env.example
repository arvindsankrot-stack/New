# Supabase (backend uses the service role key to bypass RLS after verifying
# the caller's JWT, so it can write parsed subscriptions on the user's behalf)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Anthropic API (statement parsing LLM). Leave unset to fall back to the
# built-in regex/heuristic parser (useful for local dev without an API key).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# CORS
WEB_APP_ORIGIN=http://localhost:3000
