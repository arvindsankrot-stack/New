# Copy to .env and fill in. .env is git-ignored - never commit it.

# --- Required secrets (generate with the commands in README) ---
DB_KEY=
FILE_KEY=
SESSION_SECRET=

# --- Web ---
BASE_URL=http://localhost:8000
SECURE_COOKIES=false
SESSION_MAX_AGE_HOURS=12

# --- Google OAuth for Gmail (gmail.readonly + gmail.send) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Search (configure at least one web search provider) ---
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
BRAVE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Face search (optional) ---
FACECHECK_API_TOKEN=
FACECHECK_TESTING_MODE=true

# --- Classifier (optional; falls back to local rules) ---
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-opus-5-5

# --- Tracker ---
RECHECK_DAYS=3
FOLLOWUP_DAYS=15
